{
  "physics-type": "non-physics",
  "links": [
    {
      "name": "Frame",
      "collision": {
        "enabled": false
      }
    }
  ],
  "sensors": [
    {
      "id": "MapCamera",
      "type": "camera",
      "enabled": true,
      "parent-link": "Frame",
      "capture-interval": 0.1,
      "capture-settings": [
        {
          "image-type": 0,
          "width": 512,
          "height": 512,
          "fov-degrees": 90,
          "projection-mode": 1,
          "ortho-width": 50.0,
          "capture-enabled": true,
          "streaming-enabled": false,
          "pixels-as-float": false,
          "compress": false,
          "target-gamma": 2.5
        }
      ],
      "origin": {
        "xyz": "0.0 0.0 0.0",
        "rpy-deg": "0 -90 0"
      }
    }
  ]
}
